#!/usr/bin/env python3
"""Executable launcher for `whereabout`. Symlink into ~/.local/bin/whereabout or run directly."""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if ROOT not in sys.path:
    sys.path.insert(0, ROOT)

from whereabout.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
